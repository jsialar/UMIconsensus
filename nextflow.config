// DEFAULT PARAMETERS
nextflow.preview.output = true

params {
    
    input                                 = null
    output                                = null
    reference                             = "/projects/data/GCA_000001405.15_GRCh38_no_alt_analysis_set.mmi"
    bed                                   = null
    
    snplist                               = null
    familysizethreshold                   = 5
    method                                = "adjacency"
    //READ FILTERING
    save_untrimmed                        = false
    debug                                 = false

    minlength                             = 800
    maxlength                             = 1200

    // CALL CONSENSUS
    keep_nonconsensus                     = false
    noise_threshold                       = 0.05

    // ADVANCED    
    minimap2_param                        = "-ax map-ont -k 13 --MD"
    additional_outputs                    = false //output fastq consensus files and amplicon bam files
}

profiles {
    local {
        docker.enabled = false
    }
    standard {
        process.container = 'm113track/minihap'
        docker.enabled = true
        // SPLIT_GROUP runs `samtools split -M -1`, which holds one open file
        // handle per UMI group for the whole split. The container's default
        // soft nofile limit is 1024, so it dies with "Too many open files"
        // once a region has more groups than that -- easy to hit at low
        // --familysizethreshold, where singleton families are kept.
        docker.runOptions = '--ulimit nofile=65536:524288'
    }
}

cleanup = !params.debug


manifest {
    name            = 'jsialar/UMIconsensus'
    author          = 'Jaren Sia'
    homePage        = 'https://github.com/jsialar/UMIconsensus'
    description     = 'Generate consensus from UMI'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.2'
    version         = 'v0.9.0'
}